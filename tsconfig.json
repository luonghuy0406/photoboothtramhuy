{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "composite": true,
    "rootDir": "."
  },
  "references": [
    { "path": "packages/shared" }
  ],
  "include": [],
  "exclude": ["node_modules", "dist"]
}
